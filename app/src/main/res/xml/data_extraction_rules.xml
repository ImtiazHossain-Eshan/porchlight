<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same, for the cloud backup and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="porchlight.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="porchlight.xml" />
    </device-transfer>
</data-extraction-rules>
